<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{post.title}}</h1>
    <div class="post-meta">
      <time datetime="{{post.dateISO}}">{{post.dateDisplay}}</time>{{#if post.isDraft}} &middot; <span class="draft-badge">draft</span>{{/if}}
    </div>
  </header>
  <div class="post-content">
    {{{post.content}}}
  </div>
  {{#if post.tags.length}}
  <div class="post-tags">
    {{#each post.tags}}<span class="tag">{{this}}</span>{{/each}}
  </div>
  {{/if}}
</article>
<p class="back-link"><a href="/">&larr; All posts</a></p>
